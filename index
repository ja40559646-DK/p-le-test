<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boring-Søger: Jupiter Checkpoint</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        body { display: flex; height: 100vh; margin: 0; font-family: 'Segoe UI', sans-serif; background: #eef2f3; }
        #sidebar { width: 380px; padding: 20px; background: #ffffff; border-right: 1px solid #ccc; z-index: 1000; overflow-y: auto; }
        #map { flex-grow: 1; }
        .control-group { margin-bottom: 20px; padding: 15px; background: #f9f9f9; border-radius: 8px; border: 1px solid #ddd; }
        .autocomplete-container { position: relative; }
        input[type="text"] { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        .suggestions-list { position: absolute; top: 100%; left: 0; right: 0; background: white; border: 1px solid #ddd; z-index: 2000; max-height: 200px; overflow-y: auto; }
        .suggestion-item { padding: 10px; cursor: pointer; border-bottom: 1px solid #eee; font-size: 0.9em; }
        .suggestion-item:hover { background: #3498db; color: white; }
        .stats { font-weight: bold; margin: 10px 0; color: #2c3e50; }
        .btn-fetch { background: #27ae60; color: white; border: none; padding: 12px; width: 100%; font-weight: bold; cursor: pointer; border-radius: 4px; }
        .btn-fetch:disabled { background: #bdc3c7; }
        #log-point-info { font-size: 0.8em; background: #fffde7; padding: 8px; border: 1px solid #fff59d; margin-top: 10px; border-radius: 4px; }
    </style>
</head>
<body>

<div id="sidebar">
    <h2>Projekt Opsætning</h2>
    <div class="control-group">
        <h3>1. Find Lokation</h3>
        <div class="autocomplete-container">
            <input type="text" id="addressInput" placeholder="Søg adresse..." autocomplete="off">
            <div id="suggestions" class="suggestions-list"></div>
        </div>
        <div id="log-point-info">
            <strong>Projekt-Pin:</strong> <span id="pinCoords">Ikke sat</span><br>
            <small>(Træk i rød pin for at flytte punkt)</small>
        </div>
    </div>
    <div class="control-group">
        <h3>2. Radius & Boringer</h3>
        <label>Søgeområde: <strong id="radiusVal">2000</strong> m</label>
        <input type="range" id="radiusSlider" min="100" max="10000" step="100" value="2000">
        <div id="counter" class="stats">Klar til søgning</div>
    </div>
    <div class="control-group">
        <button id="fetchDataBtn" class="btn-fetch" disabled>Gå til borings-oversigt</button>
    </div>
</div>

<div id="map"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    let map, projectPin, searchCircle, boreholeLayer;
    let currentCenter = null;

    map = L.map('map').setView([56.12, 10.61], 7);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
    boreholeLayer = L.layerGroup().addTo(map);

    const addrInput = document.getElementById('addressInput');
    const suggestionsEl = document.getElementById('suggestions');
    const radiusSlider = document.getElementById('radiusSlider');
    const counterEl = document.getElementById('counter');
    const fetchBtn = document.getElementById('fetchDataBtn');

    // --- 1. DAWA Adresser ---
    addrInput.addEventListener('input', async (e) => {
        const query = e.target.value;
        if (query.length < 3) return;
        try {
            const resp = await fetch(`https://api.dataforsyningen.dk/adresser/autocomplete?q=${encodeURIComponent(query)}`);
            const data = await resp.json();
            suggestionsEl.innerHTML = '';
            data.forEach(item => {
                const div = document.createElement('div');
                div.className = 'suggestion-item';
                div.innerText = item.tekst;
                div.onclick = () => selectAddress(item);
                suggestionsEl.appendChild(div);
            });
        } catch (err) { console.error("DAWA fejl"); }
    });

    async function selectAddress(item) {
        addrInput.value = item.tekst;
        suggestionsEl.innerHTML = '';
        const resp = await fetch(item.adresse.href);
        const data = await resp.json();
        const lat = data.adgangsadresse.adgangspunkt.koordinater[1];
        const lng = data.adgangsadresse.adgangspunkt.koordinater[0];
        setupProject(lat, lng, item.tekst);
    }

    // --- 2. Projekt-Pin ---
    function setupProject(lat, lng, label) {
        currentCenter = [lat, lng];
        if (projectPin) map.removeLayer(projectPin);
        if (searchCircle) map.removeLayer(searchCircle);

        const redIcon = new L.Icon({
            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
            shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
            iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
        });

        projectPin = L.marker([lat, lng], {icon: redIcon, draggable: true}).addTo(map);
        updatePinCoords(lat, lng);

        projectPin.on('dragend', function(e) {
            const newPos = e.target.getLatLng();
            currentCenter = [newPos.lat, newPos.lng];
            searchCircle.setLatLng(newPos);
            updatePinCoords(newPos.lat, newPos.lng);
            fetchBoreholes();
        });

        searchCircle = L.circle([lat, lng], {
            radius: parseInt(radiusSlider.value),
            color: '#3498db', fillOpacity: 0.1
        }).addTo(map);

        map.setView([lat, lng], 14);
        fetchBoreholes();
    }

    function updatePinCoords(lat, lng) {
        document.getElementById('pinCoords').innerText = `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
    }

    // --- 3. Hent Boringer fra Dataforsyningen (SDFI/Jupiter) ---
    async function fetchBoreholes() {
        if (!currentCenter) return;
        boreholeLayer.clearLayers();
        counterEl.innerText = "Søger i databasen...";

        const radius = parseInt(radiusSlider.value);
        const bbox = getBBox(currentCenter[0], currentCenter[1], radius);
        
        // Vi bruger WFS fra Dataforsyningen - den er mere stabil overfor CORS
        // Format: minLng, minLat, maxLng, maxLat
        const bboxStr = `${bbox.minLng},${bbox.minLat},${bbox.maxLng},${bbox.maxLat}`;
        const url = `https://api.dataforsyningen.dk/geus_jupiter_wfs?SERVICE=WFS&VERSION=1.1.0&REQUEST=GetFeature&TYPENAME=geus_jupiter_wfs:boring&OUTPUTFORMAT=application/json&BBOX=${bboxStr},EPSG:4326&MAXFEATURES=500`;

        try {
            const response = await fetch(url);
            if (!response.ok) throw new Error("Kunne ikke hente data");
            const data = await response.json();
            
            const features = data.features || [];
            counterEl.innerText = `Boringer fundet: ${features.length}`;
            fetchBtn.disabled = (features.length === 0);

            features.forEach(f => {
                const coords = f.geometry.coordinates; // [lng, lat]
                L.circleMarker([coords[1], coords[0]], {
                    radius: 5,
                    color: '#2c3e50',
                    fillColor: '#34495e',
                    fillOpacity: 0.8,
                    weight: 1
                }).bindTooltip(`DGU: ${f.properties.dgunr || 'Ukendt'}`).addTo(boreholeLayer);
            });
        } catch (err) {
            console.error(err);
            counterEl.innerText = "Fejl ved hentning af prikker";
        }
    }

    // --- 4. Hjælpefunktioner ---
    radiusSlider.addEventListener('input', (e) => {
        document.getElementById('radiusVal').innerText = e.target.value;
        if (searchCircle) searchCircle.setRadius(parseInt(e.target.value));
    });
    radiusSlider.addEventListener('change', fetchBoreholes);

    function getBBox(lat, lng, radiusM) {
        const degPerM = 1 / 111320;
        const latD = radiusM * degPerM;
        const lngD = (radiusM * degPerM) / Math.cos(lat * Math.PI / 180);
        return { minLat: lat - latD, maxLat: lat + latD, minLng: lng - lngD, maxLng: lng + lngD };
    }
</script>
</body>
</html>
